# Versioned, release-wide settings loaded after /etc/smebot/bot.env.
# Keep secrets, Vault references, and instance-specific settings in bot.env.
ORDERS_ENABLED=true

# Enforce the validated per-account policy; counters persist across releases.
ABUSE_LIMITS_ENABLED=true
ABUSE_ACTIVE_LISTINGS=50
ABUSE_LISTINGS_DAILY=10
ABUSE_LISTING_COOLDOWN=10
ABUSE_ORDERS_DAILY=20
ABUSE_ORDER_COOLDOWN=30
ABUSE_PENDING_ORDERS=10
ABUSE_PENDING_PER_SELLER=3
ABUSE_PHOTOS_DAILY=20
ABUSE_PHOTO_COOLDOWN=10

# Process-local Telegram request protection, independent of durable budgets.
TELEGRAM_RATE_LIMIT_ENABLED=true
TELEGRAM_RATE_LIMIT_BURST=10
TELEGRAM_RATE_LIMIT_REFILL_PER_SECOND=1
