[Unit]
Description=Export SMEbot Oracle data to private OCI recovery storage
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=smebot
Group=smebot
EnvironmentFile=/etc/smebot/bot.env
WorkingDirectory=/opt/smebot/current
ExecStart=/opt/smebot/current/.venv/bin/python scripts/recovery.py export
PrivateTmp=true
NoNewPrivileges=true

