# Install as /etc/smebot/bot.env, owned by root:smebot with mode 0640.
APP_BACKEND=oci
SECRETS_SOURCE=oci_vault
BOT_TOKEN_SECRET_OCID=ocid1.vaultsecret.oc1..replace-with-bot-token-secret
DB_DSN=SMEBOTDEV_low
DB_WALLET_DIR=/etc/smebot/wallet
DB_WALLET_PASSWORD_SECRET_OCID=ocid1.vaultsecret.oc1..replace-with-wallet-password-secret
DB_USER=SME_BOT
DB_PASSWORD_SECRET_OCID=ocid1.vaultsecret.oc1..replace-with-runtime-password-secret
OCI_NAMESPACE=zrzvcb6p4ri8
OCI_BUCKET_NAME=smebot-dev-media
OCI_RECOVERY_BUCKET=smebot-dev-recovery
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..replace-with-development-compartment
OCI_INSTANCE_OCID=ocid1.instance.oc1..replace-with-bot-instance
OCI_AUTH=instance_principal

# Enable only behind the HTTPS seller-panel reverse proxy.
SELLER_PANEL_URL=
SELLER_API_PORT=8081
