# Copy to .env (ignored by Git). Never commit passwords, API keys, or wallet files.
APP_BACKEND=oci
BOT_TOKEN=replace-with-telegram-token

# Database wallet: tnsnames.ora and ewallet.pem from this Autonomous Database.
DB_DSN=SMEBOTDEV_low
DB_WALLET_DIR=/absolute/path/to/oci_wallet
DB_WALLET_PASSWORD=replace-with-wallet-download-password
DB_USER=SME_BOT
DB_PASSWORD=replace-with-runtime-database-password
# One-time setup: the script reads ADMIN from OCI Vault if this is set.
OCI_ADMIN_SECRET_OCID=ocid1.vaultsecret.oc1..replace-me
OCI_DB_OCID=ocid1.autonomousdatabase.oc1..replace-me

# Private Object Storage bucket created by the development Terraform stack.
OCI_NAMESPACE=zrzvcb6p4ri8
OCI_BUCKET_NAME=smebot-dev-media
OCI_CONFIG_FILE=/absolute/path/to/.oci/config
OCI_PROFILE=DEFAULT
# For a hosted OCI runtime, set OCI_AUTH=resource_principal instead of a key file.
OCI_AUTH=config_file
