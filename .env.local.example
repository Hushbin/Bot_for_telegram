# Copy to .env for local development. Only Telegram needs an external connection.
# Enable new orders only after schema migration.
ORDERS_ENABLED=false
APP_BACKEND=local
BOT_TOKEN=replace-with-telegram-token

# Enable to exercise request throttling with a separate test bot.
TELEGRAM_RATE_LIMIT_ENABLED=false
TELEGRAM_RATE_LIMIT_BURST=10
TELEGRAM_RATE_LIMIT_REFILL_PER_SECOND=1

# Optional. Defaults to .local/bot.sqlite3 and .local/media/ in this repository.
# LOCAL_DB_PATH=/absolute/path/to/bot.sqlite3
# LOCAL_MEDIA_DIR=/absolute/path/to/media
